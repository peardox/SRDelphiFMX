<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{EB584342-10B8-4105-BBDD-416CF83173F6}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="SRDemoFMX\SRDemoFMX.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="SRDemoVCL\SRDemoVCL.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="SRDemoFMX">
        <MSBuild Projects="SRDemoFMX\SRDemoFMX.dproj"/>
    </Target>
    <Target Name="SRDemoFMX:Clean">
        <MSBuild Projects="SRDemoFMX\SRDemoFMX.dproj" Targets="Clean"/>
    </Target>
    <Target Name="SRDemoFMX:Make">
        <MSBuild Projects="SRDemoFMX\SRDemoFMX.dproj" Targets="Make"/>
    </Target>
    <Target Name="SRDemoVCL">
        <MSBuild Projects="SRDemoVCL\SRDemoVCL.dproj"/>
    </Target>
    <Target Name="SRDemoVCL:Clean">
        <MSBuild Projects="SRDemoVCL\SRDemoVCL.dproj" Targets="Clean"/>
    </Target>
    <Target Name="SRDemoVCL:Make">
        <MSBuild Projects="SRDemoVCL\SRDemoVCL.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="SRDemoFMX;SRDemoVCL"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="SRDemoFMX:Clean;SRDemoVCL:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="SRDemoFMX:Make;SRDemoVCL:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
